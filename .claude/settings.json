{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(fly *)",
      "Bash(flyctl *)",
      "Bash(*/fly *)",
      "Bash(*/flyctl *)",
      "Bash(scripts/deploy-fly.sh *)",
      "Bash(./scripts/deploy-fly.sh *)",
      "Bash(bash scripts/deploy-fly.sh *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * main)",
      "Bash(git push * main:main)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *merge*)",
      "Bash(gh api *protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(sqlite3 *)",
      "Bash(curl *fly.dev*)",
      "Bash(curl *fly.io*)",
      "Bash(curl *imap*)",
      "Bash(curl *smtp*)",
      "WebFetch(domain:fly.dev)",
      "WebFetch(domain:*.fly.dev)",
      "WebFetch(domain:fly.io)",
      "WebFetch(domain:*.fly.io)",
      "WebFetch(domain:imap.gmail.com)",
      "WebFetch(domain:smtp.gmail.com)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./data/**)",
      "Read(./.e2e-data/**)",
      "Read(./.e2e-mail/**)",
      "Read(**/.netrc)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./AGENTS.md)",
      "Edit(./fly.toml)",
      "Edit(./Dockerfile)",
      "Edit(./.dockerignore)",
      "Edit(./scripts/deploy-fly.sh)",
      "Edit(./e2e/visual.spec.ts-snapshots/**)",
      "Edit(./fixtures/holdout/**)",
      "Edit(./fixtures/final/**)"
    ]
  }
}
